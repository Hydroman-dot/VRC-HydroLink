<Window x:Class="HydroLink.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VRC HydroLink" Icon="Assets/HydroLink.ico" Width="1280" Height="900" MinWidth="900" MinHeight="620" Background="#0B1320" Foreground="#E5EDF7" FontFamily="Segoe UI" FontSize="14">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="VRC HydroLink" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Unified VRChat OSC, fitness, haptics and hardware bridge." Foreground="#93ADC5" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#183A40" CornerRadius="12" Padding="14,7"><TextBlock Text="0.10.0 · DEVELOPMENT PREVIEW" Foreground="#7CE8CF" FontSize="11"/></Border></Grid>
  <TabControl x:Name="Tabs" Grid.Row="1" Background="#172334" BorderThickness="0">
   <TabItem Header="Dashboard"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
    <TextBlock Text="Mein Dashboard" FontSize="25" FontWeight="SemiBold"/>
    <TextBlock Text="Eigene Werte, Verläufe und Balken. Anordnung und Karten werden gespeichert." Foreground="#93ADC5" Margin="0,8,0,12"/>
    <WrapPanel><Button Content="+ Karte hinzufügen" Click="AddCard_Click"/><CheckBox x:Name="EditDashboard" Content="Dashboard bearbeiten" Checked="DashboardEdit_Changed" Unchecked="DashboardEdit_Changed" Margin="12"/><Button Content="Layout exportieren" Click="ExportDashboard_Click"/><Button Content="Layout importieren" Click="ImportDashboard_Click"/></WrapPanel>
    <WrapPanel x:Name="DashboardCards"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Module"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
    <TextBlock Text="Deine Verbindungen. Ein Zuhause." FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Module auswählen und starten. Nur ausgewählte Quellen werden verbunden." Foreground="#93ADC5" Margin="0,8,0,20"/>
    <UniformGrid Columns="4" Margin="0,0,0,16">
     <Border Background="#203248" CornerRadius="10" Padding="18" Margin="0,0,10,0"><StackPanel><CheckBox x:Name="Fitness" Content="VR Fitness"/><TextBlock Text="Puls und Bewegung" Foreground="#93ADC5"/><TextBlock x:Name="HeartValue" Text="— bpm" FontSize="28" Margin="0,18,0,0"/><TextBlock x:Name="SpeedValue" Text="— km/h" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Background="#203248" CornerRadius="10" Padding="18" Margin="0,0,10,0"><StackPanel><CheckBox x:Name="Wind" Content="VRC WindForce"/><TextBlock Text="ESP32 · UDP" Foreground="#93ADC5"/><TextBlock x:Name="WindValue" Text="0 %" FontSize="28" Margin="0,18,0,0"/><TextBlock Text="OSC-Signal → Luftstrom" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Background="#203248" CornerRadius="10" Padding="18" Margin="0,0,10,0"><StackPanel><CheckBox x:Name="Osc" Content="OSC Hub"/><TextBlock Text="Automatisch per OSCQuery" Foreground="#93ADC5"/><TextBlock x:Name="OscCount" Text="0" FontSize="28" Margin="0,18,0,0"/><TextBlock Text="Empfangene Nachrichten" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Background="#203248" CornerRadius="10" Padding="18"><StackPanel><CheckBox x:Name="Haptics" Content="Haptics"/><TextBlock Text="Intiface · Buttplug" Foreground="#93ADC5"/><TextBlock x:Name="DeviceCount" Text="—" FontSize="28" Margin="0,18,0,0"/><TextBlock Text="Erkannte Geräte" Margin="0,8,0,0"/></StackPanel></Border>
    </UniformGrid>
    <StackPanel Orientation="Horizontal"><Button x:Name="StartButton" Content="Module starten" Click="Start_Click" Background="#167E75"/><Button x:Name="StopButton" Content="Alles stoppen" Click="Stop_Click" IsEnabled="False"/><Button Content="Einstellungen speichern" Click="Save_Click"/></StackPanel>
    <Border Background="#0E1724" CornerRadius="10" Padding="18" Margin="0,20,0,16"><StackPanel><TextBlock Text="OSCQUERY / VERBINDUNGEN" Foreground="#7CE8CF" FontSize="12"/><TextBlock x:Name="Connection" Text="Gestoppt · keine Quellen aktiv" Margin="0,10,0,0" FontSize="16"/><TextBlock x:Name="ActiveSources" Foreground="#93ADC5" Margin="0,6,0,0"/></StackPanel></Border>
    <TextBlock Text="Aktivität" FontSize="18" Margin="0,0,0,10"/><TextBox x:Name="LogBox" IsReadOnly="True" Height="180" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Verbindungen"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsPanel" Margin="24" MaxWidth="740" HorizontalAlignment="Left">
    <TextBlock Text="Quellen und Geräte" FontSize="25"/><TextBlock Text="Änderungen gelten nach dem nächsten Start der Module." Foreground="#93ADC5" Margin="0,8,0,18"/>
    <TextBlock Text="Bewegungsquelle"/><ComboBox x:Name="MovementSource" ItemsSource="{Binding MovementSources}"/><TextBlock Text="VRTI WebSocket"/><TextBox x:Name="VrtiUrl"/><TextBlock Text="FitOSC WebSocket"/><TextBox x:Name="FitUrl"/>
    <TextBlock Text="Pulsquelle"/><ComboBox x:Name="HeartSource" ItemsSource="{Binding HeartSources}"/><TextBlock Text="VRCOSC HeartRate WebSocket"/><TextBox x:Name="HeartUrl"/><TextBlock Text="Pulsoid Access Token"/><PasswordBox x:Name="PulsoidToken"/><TextBlock Text="HypeRate Geräte-ID"/><TextBox x:Name="HypeId"/><TextBlock Text="HypeRate API-Key"/><PasswordBox x:Name="HypeKey"/>
    <TextBlock Text="VRC WindForce" FontSize="20" Margin="0,16,0,10"/><TextBlock Text="Eigene Bewegungsquelle (unabhängig von VR Fitness)"/><ComboBox x:Name="WindMovementSource" ItemsSource="{Binding MovementSources}"/><TextBlock Text="Eigene Pulsquelle"/><ComboBox x:Name="WindHeartSource" ItemsSource="{Binding HeartSources}"/><TextBlock Text="ESP32 IP-Adresse"/><TextBox x:Name="WindHost"/><TextBlock Text="UDP-Befehlsport"/><TextBox x:Name="WindPort"/><TextBlock Text="OSC-Eingang (Float 0–1 → 0–100 %; ohne neue Werte nach 2 s aus)"/><TextBox x:Name="WindAddress"/>
    <TextBlock Text="Intiface" FontSize="20" Margin="0,16,0,10"/><TextBlock Text="Intiface Central WebSocket"/><TextBox x:Name="IntifaceUrl"/><TextBlock Text="Diese Preview verbindet Intiface und zeigt Geräte an. Aktuator-Routing folgt." Foreground="#93ADC5"/>
    <TextBlock Text="Android Health Companion" FontSize="20" Margin="0,16,0,10"/><CheckBox x:Name="Companion" Content="Companion-Status mit VR Fitness abrufen"/><TextBlock Text="HTTP-Basisadresse des Handys"/><TextBox x:Name="CompanionUrl"/><TextBlock Text="Pairing-Code"/><PasswordBox x:Name="CompanionCode"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="OSCQuery"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="OscSettings" Margin="24" MaxWidth="740" HorizontalAlignment="Left">
    <TextBlock Text="Ports automatisch erkennen" FontSize="25"/><TextBlock Text="HydroLink sucht VRChat über mDNS und liest den tatsächlichen UDP-Port aus OSCQuery HOST_INFO. Der eigene Empfangsport wird ebenfalls über OSCQuery veröffentlicht." Margin="0,12,0,20" Foreground="#93ADC5"/>
    <TextBlock Text="Automatisch ist Standard. Ohne gefundenes VRChat-Ziel pausiert das Senden."/><CheckBox x:Name="ManualOsc" Content="Manuelles OSC-Ziel verwenden"/><TextBlock Text="Zielhost"/><TextBox x:Name="ManualHost"/><TextBlock Text="Zielport"/><TextBox x:Name="ManualPort"/>
    <CheckBox x:Name="SendHeart" Content="Puls aus VR Fitness an Avatar senden (OSC Integer)"/><TextBlock Text="Avatar-Parameteradresse"/><TextBox x:Name="HeartAddress"/>
    <TextBlock Text="In VRChat OSC aktivieren. Die Windows-Firewall muss lokale OSCQuery-/mDNS-Kommunikation zulassen. Der HTTP-Port von OSCQuery ist nicht der UDP-Zielport." Margin="0,20,0,0" Foreground="#93ADC5"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Plugins"><StackPanel Margin="24"><TextBlock Text="Offen für Erweiterungen" FontSize="25"/><TextBlock Text="Plugins können Quellen, Prozessoren, Outputs, Services und eigene WPF-Seiten mitbringen. Sie laufen mit den Rechten der App. Nur vertrauenswürdige Plugins aktivieren." Margin="0,12,0,16" Foreground="#93ADC5"/><TextBlock Text="Plugin-IDs aktivieren (durch Komma trennen; Neustart der Anwendung erforderlich)"/><TextBox x:Name="PluginIds"/><TextBlock Text="Ablage: plugins neben der EXE, pro Plugin ein Ordner mit plugin.json und DLLs."/><TextBlock x:Name="PluginStatus" Margin="0,20,0,0"/></StackPanel></TabItem>
  </TabControl>
  <TextBlock Grid.Row="2" Text="LOCAL FIRST    ·    OSCQUERY    ·    MODULAR" Foreground="#6F8CA8" FontSize="10" Margin="0,16,0,0"/>
 </Grid>
</Window>

